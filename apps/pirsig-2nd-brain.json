{
  "name": "pirsig-2nd-brain",
  "description": "Pushes loop branches and opens pull requests on piabrota/gramatico. It never merges.",
  "url": "https://github.com/piabrota/agents",
  "hook_attributes": { "url": "https://github.com/piabrota/agents", "active": false },
  "public": false,
  "default_permissions": {
    "actions": "read",
    "contents": "write",
    "issues": "write",
    "pull_requests": "write",
    "metadata": "read"
  },
  "default_events": []
}
