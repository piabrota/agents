{
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title_pt", "summary_pt", "summary_en", "commit_message"],
  "properties": {
    "type": { "enum": ["feat", "fix", "docs", "chore"] },
    "title_pt": { "type": "string", "minLength": 3, "maxLength": 70 },
    "summary_pt": { "type": "string", "minLength": 10, "maxLength": 1500 },
    "summary_en": { "type": "string", "minLength": 10, "maxLength": 1500 },
    "commit_message": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "no_change_reason": { "type": "string", "maxLength": 600 }
  }
}
