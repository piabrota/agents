{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "failed_step", "error", "evidence", "cause", "fix", "files"],
  "properties": {
    "verdict": { "enum": ["transient", "real", "unclear"] },
    "failed_step": { "type": "string", "minLength": 1, "maxLength": 120 },
    "error": { "type": "string", "minLength": 1, "maxLength": 300 },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "text"],
        "properties": {
          "file": { "type": "string", "pattern": "^(logs/|repo/)[^ ]+$" },
          "text": { "type": "string", "minLength": 3, "maxLength": 400 }
        }
      }
    },
    "cause": { "type": "string", "minLength": 1, "maxLength": 900 },
    "fix": { "type": "string", "minLength": 1, "maxLength": 900 },
    "files": {
      "type": "array", "maxItems": 8,
      "items": { "type": "string", "pattern": "^[^ ]+$" }
    }
  }
}
