{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": { "enum": ["ok", "attention", "changes-suggested"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "findings": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "quote", "comment"],
        "properties": {
          "severity": { "enum": ["high", "medium", "low"] },
          "file": { "type": "string", "pattern": "^[^ ]+$" },
          "quote": { "type": "string", "minLength": 3, "maxLength": 300 },
          "comment": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    }
  }
}
