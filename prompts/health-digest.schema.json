{
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "status", "reason", "services", "memory_and_disk", "kubernetes", "deploys", "errors", "watch"],
  "properties": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["OK", "attention", "problem"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 },
    "services": { "type": "string", "minLength": 1, "maxLength": 300 },
    "memory_and_disk": { "type": "string", "minLength": 1, "maxLength": 300 },
    "kubernetes": { "type": "string", "minLength": 1, "maxLength": 300 },
    "deploys": { "type": "string", "minLength": 1, "maxLength": 300 },
    "errors": { "type": "string", "minLength": 1, "maxLength": 400 },
    "watch": { "type": "string", "maxLength": 300 }
  }
}
