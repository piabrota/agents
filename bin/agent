#!/usr/bin/env bash
# agent NAME: run one of piabrota's agents once. A rax task's command (README).
set -euo pipefail
AGENTS_HOME=${AGENTS_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
export AGENTS_HOME
case "${1:-}" in
  tick | feedback | deploy-doctor | health-digest | pr-reviewer | mentions | mirror-keeper | flake-annotator)
    exec "$AGENTS_HOME/agents/$1.sh"
    ;;
  *)
    echo "usage: agent tick | feedback | deploy-doctor | health-digest | pr-reviewer | mentions | mirror-keeper | flake-annotator" >&2
    exit 2
    ;;
esac
